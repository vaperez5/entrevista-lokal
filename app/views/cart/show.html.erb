<%# Vista mínima, solo para poder probar el carrito a mano. Sin agrupado por
    proveedor ni subtotales: eso llega con las vistas del flujo completo. %>

<% if notice %><p style="color: green;"><%= notice %></p><% end %>
<% if alert %><p style="color: red;"><%= alert %></p><% end %>

<h1>Carrito</h1>

<% if @cart.empty? %>
  <p>El carrito está vacío.</p>
<% else %>
  <table border="1" cellpadding="6">
    <tr>
      <th>Producto</th>
      <th>Proveedor</th>
      <th>Precio</th>
      <th>Cantidad</th>
      <th colspan="2">Acciones</th>
    </tr>
    <% @items.each do |item| %>
      <tr>
        <td><%= item.product.name %></td>
        <td><%= item.product.provider.name %></td>
        <td><%= item.product.price %></td>
        <td><%= item.quantity %></td>
        <td>
          <%= form_with url: cart_item_path(item.product), method: :patch do |f| %>
            <%= f.number_field :quantity, value: item.quantity %>
            <%= f.submit "Actualizar" %>
          <% end %>
        </td>
        <td>
          <%= button_to "Quitar", remove_cart_item_path(item.product), method: :delete %>
        </td>
      </tr>
    <% end %>
  </table>
<% end %>

<h2>Productos disponibles</h2>

<table border="1" cellpadding="6">
  <tr>
    <th>Producto</th>
    <th>Proveedor</th>
    <th>Precio</th>
    <th>Agregar</th>
  </tr>
  <% @products.each do |product| %>
    <tr>
      <td><%= product.name %></td>
      <td><%= product.provider.name %></td>
      <td><%= product.price %></td>
      <td>
        <%= form_with url: cart_items_path, method: :post do |f| %>
          <%= f.hidden_field :product_id, value: product.id %>
          <%= f.number_field :quantity, value: 1 %>
          <%= f.submit "Agregar" %>
        <% end %>
      </td>
    </tr>
  <% end %>
</table>
