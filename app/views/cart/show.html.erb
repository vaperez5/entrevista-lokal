<% content_for :title, "Carrito" %>

<h1>Carrito</h1>

<% if @cart.empty? %>
  <p>El carrito está vacío.</p>
  <p><%= link_to "Ir al catálogo", root_path %></p>
<% else %>
  <p class="hint">
    Precios vigentes del catálogo. El precio queda fijado recién al confirmar la compra.
  </p>

  <% @items_by_provider.each do |provider, items| %>
    <% subtotal = items.sum(&:line_total) %>
    <section class="group">
      <h2><%= provider.name %></h2>

      <% if provider.min_amount.positive? %>
        <p class="hint">
          Compra mínima: <%= clp(provider.min_amount) %>.
          <% unless provider.minimum_met?(subtotal) %>
            <strong>Faltan <%= clp(provider.min_amount - subtotal) %> para alcanzarla.</strong>
          <% end %>
        </p>
      <% end %>

      <table>
        <thead>
          <tr>
            <th>Producto</th>
            <th class="num">Precio unitario</th>
            <th class="num">Cantidad</th>
            <th class="num">Total línea</th>
            <th>Actualizar</th>
            <th>Quitar</th>
          </tr>
        </thead>
        <tbody>
          <% items.each do |item| %>
            <tr>
              <td><%= item.product.name %></td>
              <td class="num"><%= price_tag(item.pricing) %></td>
              <td class="num"><%= item.quantity %></td>
              <td class="num"><%= clp(item.line_total) %></td>
              <td>
                <%= form_with url: cart_item_path(item.product), method: :patch, class: "inline-form" do |f| %>
                  <%= f.number_field :quantity, value: item.quantity, min: 0, class: "qty" %>
                  <%= f.submit "Actualizar" %>
                <% end %>
              </td>
              <td>
                <%= button_to "Quitar", remove_cart_item_path(item.product), method: :delete %>
              </td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3" class="label">Subtotal <%= provider.name %></td>
            <td class="num"><strong><%= clp(subtotal) %></strong></td>
            <td colspan="2"></td>
          </tr>
        </tfoot>
      </table>
    </section>
  <% end %>

  <p class="total">Total general: <strong><%= clp(@total) %></strong></p>

  <div class="actions">
    <%= button_to "Confirmar compra", checkout_path, method: :post, class: "primary" %>
    <%= link_to "Seguir comprando", root_path %>
  </div>
<% end %>
